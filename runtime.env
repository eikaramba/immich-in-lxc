# https://immich.app/docs/install/environment-variables/

# Immich
TZ=Europe/Berlin
IMMICH_VERSION=release
IMMICH_ENV=production

# Postgresql
DB_HOSTNAME=localhost
DB_USERNAME=immich
DB_PASSWORD='A_SEHR_SAFE_PASSWORD'
DB_DATABASE_NAME=immich
# Note: DB_VECTOR_EXTENSION is no longer needed in Immich v3+ (VectorChord is default)

# Redis
REDIS_HOSTNAME=localhost

# Machine learning
MACHINE_LEARNING_CACHE_FOLDER=/home/immich/ml-models

# Hardware acceleration settings for AMD ROCm / Strix Halo:
# DEVICE=rocm
# HSA_OVERRIDE_GFX_VERSION=11.5.1

